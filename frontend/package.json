{
  "name": "personal-website-content-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run build:pet",
    "build:pet": "esbuild ../src/components/DesktopPet/DesktopPet.ts --bundle --format=esm --target=es2020 --outfile=../js/desktop-pet.js && esbuild ../src/components/DesktopPet/DesktopPet.css --bundle --outfile=../css/desktop-pet.css",
    "typecheck": "tsc --project tsconfig.pet.json --noEmit",
    "sync": "node scripts/sync-notion.js",
    "render": "node scripts/sync-notion.js --render-existing",
    "fcn:dev": "vite --config fcn-research/vite.config.ts",
    "fcn:typecheck": "tsc -p fcn-research/tsconfig.json --noEmit",
    "fcn:test": "vitest run --config fcn-research/vite.config.ts",
    "fcn:build": "vite build --config fcn-research/vite.config.ts"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.6",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
